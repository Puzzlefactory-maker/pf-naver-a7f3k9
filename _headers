# Netlify 응답 헤더 설정 (GitHub Pages 등 다른 호스팅에서는 무시됩니다)

# 매니페스트는 정식 형식으로 내려줘야 브라우저가 확실하게 인식합니다
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# 본체·데이터·서비스워커는 항상 최신 파일인지 확인하고 받도록 합니다
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/seed.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
